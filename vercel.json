{
  "version": 2,
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": "/api"
    },
    {
      "source": "/metrics",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/",
      "destination": "/website/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/website/index.html"
    },
    {
      "source": "/style.css",
      "destination": "/website/style.css"
    },
    {
      "source": "/script.js",
      "destination": "/website/script.js"
    }
  ]
}
